# Secrets — never commit
.env
.env.*
!.env.example
auth.json
*.pem
*.key
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*.ppk

# Internal planning workbook — non-sensitive extracts live in docs/PRODUCT-BRIEF.md,
# docs/WEBSITE-REQUIREMENTS.md and docs/THEME-DECISION-BRIEF.md instead.
Lyli-Shop-90-Day-Project-Management-Workbook.xlsx
*.xlsx
*.xls

# Composer-managed WordPress core, plugins, themes (declared in composer.json)
/web/wp/
/web/app/plugins/*
!/web/app/plugins/.gitkeep
/web/app/themes/storefront/
/vendor/
composer.phar

# Uploads — belong to shared/uploads on the host, not the release artifact
/web/app/uploads/

# Backups and dumps — never committed (PLAN.md section 10.2)
*.sql
*.sql.gz
/backups/
/scratch/

# Build artifacts
/artifacts/
/dist/
*.zip
*.tar.gz

# Editor/OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# DDEV local state
.ddev/.*
!.ddev/config.yaml

# Node (theme asset build, if any)
node_modules/
