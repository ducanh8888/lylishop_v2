{
  "$schema": "https://schemas.wp.org/wp/6.0/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "730px",
      "wideSize": "1140px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "name": "Nâu ấm chủ đạo",
          "slug": "lyli-primary",
          "color": "#7A3B17"
        },
        {
          "name": "Trắng ấm — nền chính",
          "slug": "lyli-warm-white",
          "color": "#FFFCF7"
        },
        {
          "name": "Kem — nền phụ",
          "slug": "lyli-cream",
          "color": "#FBEFE5"
        },
        {
          "name": "Hồng phấn — điểm nhấn",
          "slug": "lyli-blush",
          "color": "#F6E4E3"
        },
        {
          "name": "Xanh sage — điểm nhấn",
          "slug": "lyli-sage",
          "color": "#E9F1EA"
        },
        {
          "name": "Tím xám — điểm nhấn",
          "slug": "lyli-lavender",
          "color": "#C2C3D2"
        },
        {
          "name": "Trung tính chức năng — chữ chính",
          "slug": "lyli-text",
          "color": "#2D2A26"
        },
        {
          "name": "Trung tính chức năng — chữ phụ",
          "slug": "lyli-text-muted",
          "color": "#6B6560"
        },
        {
          "name": "Trung tính chức năng — viền",
          "slug": "lyli-border",
          "color": "#E4DED8"
        }
      ]
    },
    "typography": {
      "fontWeight": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Fraunces\", Georgia, \"Times New Roman\", serif",
          "slug": "lyli-heading",
          "name": "Fraunces — Tiêu đề"
        },
        {
          "fontFamily": "\"Be Vietnam Pro\", \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif",
          "slug": "lyli-body",
          "name": "Be Vietnam Pro — Nội dung & CTA"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "14px"
        },
        {
          "name": "Normal",
          "slug": "normal",
          "size": "16px"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "clamp(17px, calc(16px + 0.25vw), 18px)"
        },
        {
          "name": "Larger",
          "slug": "larger",
          "size": "clamp(21px, calc(18px + 0.75vw), 24px)"
        },
        {
          "name": "Extra large",
          "slug": "extra-large",
          "size": "clamp(28px, calc(24px + 1.2vw), 36px)"
        },
        {
          "name": "Huge",
          "slug": "huge",
          "size": "clamp(32px, calc(24px + 2.4vw), 48px)"
        },
        {
          "name": "Gigantic",
          "slug": "gigantic",
          "size": "clamp(34px, calc(22px + 3.4vw), 64px)"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "name": "xxs",
          "slug": "20",
          "size": "0.5rem"
        },
        {
          "name": "xs",
          "slug": "30",
          "size": "0.75rem"
        },
        {
          "name": "sm",
          "slug": "40",
          "size": "1rem"
        },
        {
          "name": "md",
          "slug": "50",
          "size": "1.5rem"
        },
        {
          "name": "lg",
          "slug": "60",
          "size": "2rem"
        },
        {
          "name": "xl",
          "slug": "70",
          "size": "3rem"
        },
        {
          "name": "xxl",
          "slug": "80",
          "size": "4rem"
        }
      ]
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--lyli-body)",
      "fontWeight": "400",
      "lineHeight": "1.7"
    },
    "color": {
      "text": "var(--wp--preset--color--lyli-text)",
      "background": "var(--wp--preset--color--lyli-warm-white)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--lyli-heading)",
          "fontWeight": "600",
          "lineHeight": "1.2"
        },
        "color": {
          "text": "var(--wp--preset--color--lyli-primary)"
        }
      },
      "button": {
        "border": {
          "radius": "999px"
        },
        "color": {
          "background": "var(--wp--preset--color--lyli-primary)",
          "text": "var(--wp--preset--color--lyli-warm-white)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--lyli-body)",
          "fontWeight": "500"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "right": "24px",
            "bottom": "12px",
            "left": "24px"
          }
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--lyli-primary)"
        }
      }
    },
    "spacing": {
      "blockGap": "24px",
      "padding": {
        "left": "0px",
        "right": "0px"
      }
    }
  }
}
